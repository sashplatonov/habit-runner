# Example environment variables for the Habbit Runner API.
# Copy this file to server/.env and adjust values before running the server.

DATABASE_URL=postgresql://habbit:password@db:5432/habbit_runner
DEFAULT_DB_SCHEMA=habbit_runner
APP_SCHEMA_HEADER=x-habbit-runner-app
PORT=4000
AUTH_SECRET=change-me
ACCESS_TOKEN_EXPIRES_IN=1h
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_EXPIRES_DAYS=30
API_PUBLIC_URL=http://localhost:4000
OAUTH_DEFAULT_RETURN_TO=http://localhost:5173


GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
