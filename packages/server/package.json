{
  "name": "@habbit-runner/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix --max-warnings 0",
    "test": "rm -rf dist-test && npx tsc -p tsconfig.test.json && node --test dist-test/test/**/*.test.js && rm -rf dist-test",
    "test:unit": "rm -rf dist-test && npx tsc -p tsconfig.test.json && node --test dist-test/test/unit/**/*.test.js && rm -rf dist-test",
    "test:e2e": "rm -rf dist-test && npx tsc -p tsconfig.test.json && node --test dist-test/test/e2e/**/*.test.js && rm -rf dist-test",
    "test:coverage": "rm -rf dist-test && npx tsc -p tsconfig.test.json && node --test --experimental-test-coverage dist-test/test/**/*.test.js && rm -rf dist-test",
    "prisma": "npx prisma",
    "seed": "ts-node prisma/seed.ts",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "@habbit-runner/shared": "*",
    "@nestjs/common": "^11.1.16",
    "@nestjs/core": "^11.1.16",
    "@nestjs/platform-express": "^11.1.16",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.3.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.3.5",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "eslint": "^10.0.3",
    "prisma": "^7.4.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
