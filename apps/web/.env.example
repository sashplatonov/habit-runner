# API base URL (use /api for Docker with nginx proxy, or http://localhost:3000 for local dev)
VITE_API_BASE_URL=http://localhost:3000

# Canonical CORS origins (shared with backend). Use a comma-separated list for multiple origins.
CORS_ORIGINS=http://localhost:5137

# Set to "false" to disable sync
VITE_SYNC_ENABLED=true

# Default user ID embedded in Dexie records (for local dev without auth)
VITE_DEFAULT_USER_ID=

# Google Search Console verification token (get from https://search.google.com/search-console)
VITE_GSC_VERIFICATION_TOKEN=

# Bing Webmaster Tools verification token (get from https://www.bing.com/webmasters)
VITE_BING_VERIFICATION_TOKEN=

# GA4 Measurement ID (get from Google Analytics, format: G-XXXXXXXXXX)
VITE_GA4_MEASUREMENT_ID=

# Grafana / observability (optional)
VITE_FARO_URL=
VITE_FARO_APP_NAME=habbit-runner-web
