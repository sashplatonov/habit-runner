{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client", "vitest/globals"]
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.js",
    "src/**/*.svelte",
    "src/**/*.ts",
    "tests/**/*.js",
    "tests/**/*.ts"
  ],
  "exclude": [
    "src/**/*.jsx",
    "src/**/*.tsx",
    "tests/**/*.jsx",
    "tests/**/*.tsx",
    "src/App.tsx",
    "src/index.tsx",
    "src/hooks/**/*.ts",
    "src/lib/router.tsx",
    "src/pages/**/*.ts",
    "src/pages/**/*.tsx",
    "src/service-worker.ts",
    "src/sw-custom.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
