{
  "name": "@habbit-runner/web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "prepare": "npm run build -w @habbit-runner/shared",
    "sync:svelte": "svelte-kit sync",
    "dev": "npm run sync:svelte && npx vite dev",
    "dev:web": "npm run dev",
    "monorepo:dev": "turbo dev",
    "dev:server": "bash ./scripts/dev-server.sh",
    "dev:all": "npm run dev --workspaces --if-present",
    "build": "npm run sync:svelte && npx vite build",
    "monorepo:build": "turbo build",
    "build:web": "npm run build",
    "build:server": "cd ../backend && (./mvnw package -DskipTests || mvn -DskipTests package)",
    "check:runtime-undefined": "npm run sync:svelte && node ./scripts/check-runtime-undefined.cjs",
    "check:svelte-keys": "node ./scripts/check-svelte-keys.cjs",
    "check:types": "npm run sync:svelte && svelte-check --tsconfig ./tsconfig.json",
    "check:shared": "npm run lint -w @habbit-runner/shared && npm run build -w @habbit-runner/shared",
    "check:web": "npm run lint && npm run check:shared && npm run check:types && npm run build",
    "prebuild": "if [ \"$SKIP_LINT\" = \"1\" ]; then echo 'skip-lint'; else npm run lint && npm run check:runtime-undefined; fi && npm run build -w @habbit-runner/shared",
    "lint": "npm run check:svelte-keys && npm run check:runtime-undefined && eslint src tests --ext .js,.ts,.svelte --max-warnings 0",
    "lint:fix": "npm run check:runtime-undefined && eslint src tests --ext .js,.ts,.svelte --fix --max-warnings 0",
    "monorepo:lint": "turbo lint",
    "preview": "node ./scripts/preview-static.mjs",
    "test": "npm run sync:svelte && vitest run",
    "test:unit": "npm run sync:svelte && vitest run",
    "test:coverage": "npm run sync:svelte && vitest run --coverage",
    "test:watch": "npm run sync:svelte && vitest",
    "test:ui": "npm run sync:svelte && vitest --ui",
    "check": "npm run check:web && npm run build:server",
    "clean": "turbo run clean"
  },
  "dependencies": {
    "@habbit-runner/shared": "*",
    "@newrelic/browser-agent": "^1.317.0",
    "@sindresorhus/slugify": "^3.0.0",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "dexie": "^4.4.4",
    "dompurify": "^3.4.11",
    "gray-matter": "^4.0.3",
    "lucide-svelte": "^0.577.0",
    "marked": "^18.0.5",
    "nanoid": "^5.1.16",
    "web-vitals": "^5.3.0"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-musl": "4.62.2",
    "@rollup/rollup-linux-x64-musl": "4.62.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.2",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/dom": "^10.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vite-pwa/sveltekit": "^1.1.0",
    "@tailwindcss/vite": "^4.3.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.0.1",
    "globals": "^17.7.0",
    "eslint-plugin-svelte": "^3.20.0",
    "jsdom": "^22.1.0",
    "postcss": "^8.5.16",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.2",
    "tailwindcss": "^4.3.2",
    "turbo": "^2.10.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.10",
    "workbox-precaching": "^7.4.1"
  },
  "overrides": {
    "@nestjs/common": "^11.1.16",
    "@nestjs/core": "^11.1.16",
    "@hono/node-server": "^1.19.10",
    "hono": "^4.12.4",
    "@prisma/dev": {
      "@hono/node-server": "^1.19.10",
      "hono": "^4.12.4"
    },
    "@nestjs/schedule": {
      "@nestjs/common": "^11.1.16",
      "@nestjs/core": "^11.1.16"
    },
    "@nestjs/throttler": {
      "@nestjs/common": "^11.1.16",
      "@nestjs/core": "^11.1.16"
    }
  }
}
