<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0
        https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">

    <!-- Exclude annotation-processor generated sources -->
    <Match>
        <Source name="~.*[\\/]generated-sources[\\/].*"/>
    </Match>

    <!-- Records expose their components via accessors; the referenced arrays/collections
         are immutable in practice. EI_EXPOSE_REP and EI_EXPOSE_REP2 are false positives
         for record types because Java records do not allow field mutation. -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- JPA entity public fields are written by Hibernate via reflection — SpotBugs
         cannot observe this write path and incorrectly reports them as unwritten. -->
    <Match>
        <Bug pattern="UWF_UNWRITTEN_PUBLIC_OR_PROTECTED_FIELD"/>
        <Class name="~.*Entity"/>
    </Match>

    <!-- CDI/JAX-RS @Context fields are injected by the container at request time;
         SpotBugs cannot observe this and incorrectly flags them as null dereferences. -->
    <Match>
        <Bug pattern="NP_UNWRITTEN_FIELD"/>
    </Match>

</FindBugsFilter>
