{
  "name": "habbit-runner",
  "private": true,
  "packageManager": "npm@11.11.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "npm run build -w @habbit-runner/shared",
    "dev": "turbo dev",
    "dev:web": "npm run dev --workspace=@habbit-runner/web",
    "dev:server": "cd apps/api-java && ./mvnw quarkus:dev",
    "dev:all": "npm run dev --workspaces --if-present",
    "build": "turbo build",
    "build:web": "npm run build --workspace=@habbit-runner/web",
    "build:server": "cd apps/api-java && (./mvnw package -DskipTests || mvn -DskipTests package)",
    "lint": "turbo lint",
    "lint:fix": "turbo run lint:fix",
    "check": "npm run lint && npm run build && npm run build:server",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@nestjs/common": "^11.1.16",
    "@nestjs/core": "^11.1.16",
    "@nestjs/platform-express": "^11.1.16",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "turbo": "^2.8.14"
  },
  "overrides": {
    "@nestjs/common": "^11.1.16",
    "@nestjs/core": "^11.1.16",
    "@hono/node-server": "^1.19.10",
    "hono": "^4.12.4",
    "@prisma/dev": {
      "@hono/node-server": "^1.19.10",
      "hono": "^4.12.4"
    },
    "@nestjs/schedule": {
      "@nestjs/common": "^11.1.16",
      "@nestjs/core": "^11.1.16"
    },
    "@nestjs/throttler": {
      "@nestjs/common": "^11.1.16",
      "@nestjs/core": "^11.1.16"
    }
  }
}
