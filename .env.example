# Root environment example for the Vite client.
# Copy to .env and adjust values before running the UI.

VITE_API_BASE_URL=http://localhost:4000
VITE_SYNC_ENABLED=true

# docker compose port mappings
API_PORT=4000
WEB_PORT=5173
DB_PORT=5433

# docker compose database credentials
HR_DB_NAME=habbit_runner
HR_DB_USER=habbit
HR_DB_PASSWORD=password
