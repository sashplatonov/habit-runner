# Root .env.example — all environment examples are in the repository root.
# DO NOT commit real secrets. Populate secrets from CI or a local `.env` file.

# ── Network / General
VITE_API_BASE_URL=/api
VITE_SYNC_ENABLED=true
VITE_DEFAULT_USER_ID=
VITE_GSC_VERIFICATION_TOKEN=
VITE_BING_VERIFICATION_TOKEN=
VITE_GA4_MEASUREMENT_ID=
API_PORT=8080
WEB_PORT=80

# ── Frontend RUM (Grafana Faro) — build-time vars for the web image
VITE_FARO_URL=
VITE_FARO_APP_NAME=Habbit Runner
VITE_FARO_APP_VERSION=1.0.0
VITE_FARO_ENVIRONMENT=production
VITE_FARO_SAMPLING_RATE=1
VITE_FARO_PERSISTENT_SESSIONS=false
VITE_FARO_ENABLED=true

# ── Postgres (db container)
# For docker-compose local development the DB_HOST is usually `db`.
DB_HOST=db
DB_PORT=5432
DB_NAME=habbit
DB_USER=habbit
DB_PASSWORD=
DB_SCHEMA=public

# ── Authentication / Tokens
JWT_ISSUER=habittracker
AUTH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=3600
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_EXPIRES_DAYS=30
API_PUBLIC_URL=http://localhost:5137/api
OAUTH_DEFAULT_RETURN_TO=http://localhost:5137
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CORS_ORIGINS=http://localhost:5137

# Canonical CORS origins used by API and web (nginx). Use a comma-separated list for multiple origins.
# Set `CORS_ORIGINS` in your local `.env` to override.

# ── Web Push (VAPID)
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Observability (Docker Compose Alloy sidecar → Grafana Cloud Mimir)
# App version (recommended): semantic release tag or build id
APP_VERSION=1.0.0
# Backwards compatibility: SERVICE_VERSION is still accepted by the app
SERVICE_VERSION=1.0.0

# Deployment environment (recommended values: production/staging/development)
DEPLOYMENT_ENV=development
# Backwards compatibility: ENVIRONMENT is still accepted
ENVIRONMENT=development

# ── New Relic (Java agent + logs-in-context)
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=habittracker-api
NEW_RELIC_AGENT_ENABLED=false
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_ENABLED=false
NEW_RELIC_APPLICATION_LOGGING_FORWARDING_MAX_SAMPLES_STORED=10000
NEW_RELIC_APPLICATION_LOGGING_LOCAL_DECORATING_ENABLED=false

# Metrics — Grafana Cloud Mimir (Prometheus remote_write)
# URL:      grafana.com → My Stack → Prometheus → Remote Write Endpoint
# Username: grafana.com → My Stack → Prometheus → Username (numeric instanceId)
GRAFANA_MIMIR_URL=https://prometheus-prod-<region>.grafana.net/api/prom/push
GRAFANA_MIMIR_USERNAME=<numeric-instanceId>
GRAFANA_METRICS_API_KEY=<Access Policy token with metrics:write scope>
