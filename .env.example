# Root Docker Compose environment.
# Copy to `/.env` and adjust values before running `docker compose up`.

# Published ports
WEB_PORT=80
API_PORT=8080

# Postgres container credentials (canonical names)
# Host and port are optional; when running via Docker Compose the DB host is usually `db`.
DB_HOST=db
DB_PORT=5432
DB_NAME=habbit_runner
DB_USER=habbit
DB_PASSWORD=password
DB_SCHEMA=habbit_runner

# API container env (used by docker compose `api` service)
# `DATABASE_URL` may be set explicitly, otherwise docker-compose builds it from `DB_*`.
#DATABASE_URL=postgresql://habbit:password@db:5432/habbit_runner
# Note: Quarkus datasource env vars are not required — the stack uses `DATABASE_URL` or `DB_*`.
AUTH_SECRET=change-me
ACCESS_TOKEN_EXPIRES_IN=1h
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_EXPIRES_DAYS=30
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Public URL of the API as seen by the browser (used for OAuth redirect URI)
# Must match the authorized redirect URI in Google OAuth Console:
#   https://yourdomain.com/api/auth/google/callback
API_PUBLIC_URL=https://yourdomain.com/api

# URL the user is redirected to after successful login
OAUTH_DEFAULT_RETURN_TO=https://yourdomain.com

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=https://yourdomain.com

# Web Push Notifications (for background reminders on mobile PWA and desktop browser)
# Generate new keys with: npx web-push generate-vapid-keys
# Keep these secret! Use secure environment variables in production (GitHub Secrets, etc)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@yourdomain.com

# JWT issuer used when signing/verifying tokens
JWT_ISSUER=habittracker-local

# Local dev only (not used by Docker):
# API_TARGET_URL=http://localhost:3000   # Vite proxy target for npm run dev:web

# Grafana Faro (Frontend Observability) — optional
# Example:
# VITE_FARO_URL=https://faro-collector-prod-eu-west-2.grafana.net/collect/<your-collector-id>
VITE_FARO_API_KEY=
VITE_FARO_URL=
VITE_FARO_API_KEY=
VITE_FARO_APP_NAME=Habbit Runner
VITE_FARO_APP_VERSION=1.0.0
VITE_FARO_ENVIRONMENT=production
VITE_FARO_SAMPLING_RATE=1
VITE_FARO_PERSISTENT_SESSIONS=false

# OpenTelemetry / OTLP (traces)
# When using Grafana Cloud OTLP, set these to the values provided by Grafana Cloud.
# Do NOT commit real API keys. Use your platform secret manager or Kubernetes Secrets.
# Example:
OTEL_EXPORTER_OTLP_ENDPOINT=https://<GRAFANA_OTLP_ENDPOINT>
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer <GRAFANA_API_KEY>
OTEL_RESOURCE_ATTRIBUTES=service.name=habbit-runner-backend,service.version=1.0.0

