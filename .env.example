# Root .env.example — all environment examples are in the repository root.
# DO NOT commit real secrets. Populate secrets from CI or a local `.env` file.

# ── Network / General
VITE_API_BASE_URL=/api
API_PORT=8080
WEB_PORT=80

# ── Postgres (db container)
# For docker-compose local development the DB_HOST is usually `db`.
DB_HOST=db
DB_PORT=5432
DB_NAME=habbit
DB_USER=habbit
DB_PASSWORD=
DB_SCHEMA=public

# ── Authentication / Tokens
JWT_ISSUER=habittracker
AUTH_SECRET=
ACCESS_TOKEN_EXPIRES_IN=3600
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_EXPIRES_DAYS=30
API_PUBLIC_URL=http://localhost:5173
OAUTH_DEFAULT_RETURN_TO=http://localhost:5173/auth/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
CORS_ORIGINS=http://localhost:5173

# ── Web Push (VAPID)
# Generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Observability (Grafana Agent — scrape + OTLP receiver architecture)
# Service identity injected as OTel resource attributes and Loki labels.
# grafana.com → My Account → Stack Details → (no specific page — values you choose)
OTEL_SERVICE_NAME=habittracker-api
SERVICE_VERSION=1.0.0
ENVIRONMENT=production

# Metrics — Grafana Cloud Mimir (Prometheus remote_write)
# URL:      grafana.com → My Stack → Prometheus → Remote Write Endpoint
# Username: grafana.com → My Stack → Prometheus → Username (numeric instanceId)
GRAFANA_MIMIR_URL=https://prometheus-prod-<region>.grafana.net/api/prom/push
GRAFANA_MIMIR_USERNAME=<numeric-instanceId>
GRAFANA_METRICS_API_KEY=<Access Policy token with metrics:write scope>

# Traces — Grafana Cloud Tempo
# Endpoint: grafana.com → My Stack → Tempo → OTLP gRPC  (host:port without scheme)
# Username: grafana.com → My Stack → Tempo → Username (numeric instanceId)
GRAFANA_TEMPO_ENDPOINT=tempo-prod-<region>-<number>.grafana.net:443
GRAFANA_TEMPO_USERNAME=<numeric-instanceId>
GRAFANA_TRACES_API_KEY=<Access Policy token with traces:write scope>

# Logs — Grafana Cloud Loki
# URL:      grafana.com → My Stack → Loki → URL, append /loki/api/v1/push
# Username: grafana.com → My Stack → Loki → Username (numeric instanceId)
GRAFANA_LOKI_URL=https://logs-prod-<region>.grafana.net/loki/api/v1/push
GRAFANA_LOKI_USERNAME=<numeric-instanceId>
GRAFANA_LOGS_API_KEY=<Access Policy token with logs:write scope>

# ── Frontend RUM (Grafana Faro) — build-time VITE_* args
# Vite inlines VITE_* values at build time. Pass them as build-args in CI
# or via docker build --build-arg when building the web image.
VITE_FARO_ENABLED=true
VITE_FARO_URL=https://faro-collector-prod-<region>.grafana.net/collect/<token>
VITE_FARO_APP_NAME=Habbit Runner
VITE_FARO_APP_VERSION=1.0.0
VITE_FARO_ENVIRONMENT=production
VITE_FARO_SAMPLING_RATE=1.0
VITE_FARO_PERSISTENT_SESSIONS=false
